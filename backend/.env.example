# Copy to .env for local dev, or set these as real environment variables in
# your hosting platform (Render/Railway/Fly/etc). See README.md for the full
# explanation of each adapter and how to switch it to the real Supabase-backed
# implementation.

# --- Database -----------------------------------------------------------
# Local dev default. In production, point this at your Supabase Postgres
# connection string (Project Settings -> Database -> Connection string ->
# "Session pooler" or "Direct connection" — NOT "Transaction pooler").
FACTORY_DATABASE_URL=postgresql+psycopg2://factory_app:factory_dev_pw@localhost:5432/factory_os

# --- Storage --------------------------------------------------------------
# "local" (filesystem, dev default) or "supabase"
FACTORY_STORAGE_PROVIDER=local
FACTORY_LOCAL_STORAGE_DIR=./storage_data
# Required only when FACTORY_STORAGE_PROVIDER=supabase:
FACTORY_SUPABASE_URL=
FACTORY_SUPABASE_SERVICE_KEY=
FACTORY_SUPABASE_STORAGE_BUCKET=inward-vehicle-inspection

# --- Auth -------------------------------------------------------------------
# "dev" (static bearer-token users, default) or "supabase" (real Google OAuth
# via Supabase Auth, once wired up)
FACTORY_AUTH_PROVIDER=dev
# Required only when FACTORY_AUTH_PROVIDER=supabase:
FACTORY_SUPABASE_JWT_SECRET=

# --- OCR ------------------------------------------------------------------
# "tesseract" (real, local, default) or "none"
FACTORY_OCR_PROVIDER=tesseract

# --- CORS -------------------------------------------------------------------
# JSON array of allowed frontend origins.
FACTORY_CORS_ORIGINS=["http://localhost:3000"]
