# Copy to .env.local for local dev, or set as an environment variable in
# your hosting platform (Vercel, etc).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase project -- Settings -> API in the Supabase dashboard.
# Required for sign-in (Google OAuth via Supabase Auth) to work at all.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>

